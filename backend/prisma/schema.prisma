generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------------------------
// Enums
// --------------------------------------------------------

enum SkillVerificationStatus {
  UNVERIFIED
  PARTIALLY_DEMONSTRATED
  DEMONSTRATED
  CERTIFIED
}

enum ClaimSource {
  USER_INPUT
  CV_PARSED
  GITHUB_ANALYZED
  ASSESSMENT_PASSED
}

enum ApplicationStatus {
  DISCOVERED
  SAVED
  ANALYZING
  GAP_IDENTIFIED
  CV_TAILORED
  AWAITING_USER_APPROVAL
  APPROVED
  SUBMITTED
  SUBMISSION_FAILED
  INTERVIEW_SCHEDULED
  OFFERED
  REJECTED
  WITHDRAWN
}

enum IntegrationProvider {
  GITHUB
  GOOGLE_DRIVE
  GMAIL
  LINKEDIN
}

enum RemotePreference {
  REMOTE
  HYBRID
  ONSITE
}

// --------------------------------------------------------
// 1. Users & Authentication
// --------------------------------------------------------

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String?
  fullName        String
  phone           String?
  locationCountry String   @default("Sri Lanka")
  locationCity    String   @default("Colombo")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  careerProfile     CareerProfile?
  skills            Skill[]
  skillGapReports   SkillGapReport[]
  cvVersions        CvVersion[]
  applications      Application[]
  approvalRequests  ApprovalRequest[]
  auditLogs         AgentAuditLog[]
  integrations      ConnectedIntegration[]
  learningPlans     LearningPlan[]
  portfolio         PortfolioSite?

  @@map("users")
}

// --------------------------------------------------------
// 2. Unified Career Profile & History
// --------------------------------------------------------

model CareerProfile {
  id                     String           @id @default(uuid())
  userId                 String           @unique
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline               String?
  summary                String?
  yearsExperience        Decimal          @default(0.0) @db.Decimal(3, 1)
  targetRoles            String[]         @default([])
  targetLocations        String[]         @default([])
  remotePreference       RemotePreference @default(HYBRID)
  expectedSalaryMin      Decimal?         @db.Decimal(12, 2)
  expectedSalaryCurrency String           @default("LKR")
  updatedAt              DateTime         @updatedAt

  experiences Experience[]
  education   Education[]
  projects    Project[]

  @@map("career_profiles")
}

model Experience {
  id          String        @id @default(uuid())
  profileId   String
  profile     CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company     String
  role        String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean       @default(false)
  bullets     String[]      @default([])

  @@map("experiences")
}

model Education {
  id           String        @id @default(uuid())
  profileId    String
  profile      CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution  String
  degree       String
  fieldOfStudy String?
  startYear    Int
  endYear      Int?
  grade        String?

  @@map("education")
}

model Project {
  id           String        @id @default(uuid())
  profileId    String
  profile      CareerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String
  summary      String
  technologies String[]      @default([])
  repoUrl      String?
  liveDemoUrl  String?
  source       String        @default("USER_INPUT")

  @@map("projects")
}

// --------------------------------------------------------
// 3. Skills with Provenance & Evidence Verification
// --------------------------------------------------------

model Skill {
  id              String                  @id @default(uuid())
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  category        String                  // LANGUAGE, FRAMEWORK, DATABASE, SOFT_SKILL, etc.
  proficiency     String                  @default("INTERMEDIATE")
  status          SkillVerificationStatus @default(UNVERIFIED)
  source          ClaimSource             @default(USER_INPUT)
  confidenceScore Decimal                 @default(0.50) @db.Decimal(3, 2)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  evidence SkillEvidence[]

  @@unique([userId, name])
  @@map("skills")
}

model SkillEvidence {
  id           String    @id @default(uuid())
  skillId      String
  skill        Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  evidenceType String    // GITHUB_REPO, CERTIFICATE, ACADEMIC_PROJECT
  referenceUrl String?
  title        String
  rawSnippet   String?
  verifiedAt   DateTime?

  @@map("skill_evidence")
}

// --------------------------------------------------------
// 4. Job Catalog
// --------------------------------------------------------

model Job {
  id               String    @id @default(uuid())
  externalId       String?
  source           String    // ROOSTER_LK, TOPJOBS_LK, LINKEDIN, MANUAL
  companyName      String
  title            String
  location         String?
  isRemote         Boolean   @default(false)
  employmentType   String    @default("FULL_TIME")
  rawDescription   String
  normalizedSkills String[]  @default([])
  deadline         DateTime?
  url              String?
  createdAt        DateTime  @default(now())

  applications    Application[]
  skillGapReports SkillGapReport[]
  cvVersions      CvVersion[]
  learningPlans   LearningPlan[]

  @@unique([source, externalId])
  @@map("jobs")
}

// --------------------------------------------------------
// 5. Skill Gap Reports
// --------------------------------------------------------

model SkillGapReport {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId              String
  job                Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  matchPercentage    Decimal  @db.Decimal(5, 2)
  demonstratedSkills String[] @default([])
  mandatoryGaps      String[] @default([])
  optionalGaps       String[] @default([])
  strengths          String[] @default([])
  analysisRationale  Json
  createdAt          DateTime @default(now())

  @@map("skill_gap_reports")
}

// --------------------------------------------------------
// 6. Tailored CV Versions & ATS Optimization
// --------------------------------------------------------

model CvVersion {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId              String?
  job                Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  versionTag         String   // e.g. "v1.0-base", "v1.1-wso2-internship"
  structuredContent  Json     // Full JSON AST of CV sections & bullets
  tailoringRationale Json?    // Diff log of modifications vs base CV
  atsScore           Decimal? @db.Decimal(5, 2)
  filePdfUrl         String?
  isBaseVersion      Boolean  @default(false)
  createdAt          DateTime @default(now())

  applications Application[]

  @@map("cv_versions")
}

// --------------------------------------------------------
// 7. Applications Lifecycle
// --------------------------------------------------------

model Application {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId             String
  job               Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cvVersionId       String?
  cvVersion         CvVersion?        @relation(fields: [cvVersionId], references: [id], onDelete: SetNull)
  status            ApplicationStatus @default(DISCOVERED)
  submissionChannel String            @default("MANUAL") // PORTAL_API, EMAIL_FORWARD, MANUAL
  submittedAt       DateTime?
  lastAgentAction   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  approvalRequests ApprovalRequest[]

  @@map("applications")
}

// --------------------------------------------------------
// 8. Human-in-the-Loop Approval Ledger
// --------------------------------------------------------

model ApprovalRequest {
  id                  String       @id @default(uuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId       String?
  application         Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actionType          String       // SUBMIT_APPLICATION, SEND_EMAIL, PUBLISH_PORTFOLIO
  payload             Json
  payloadHash         String?
  isApproved          Boolean      @default(false)
  isRejected          Boolean      @default(false)
  userRejectionReason String?
  respondedAt         DateTime?
  createdAt           DateTime     @default(now())

  @@map("approval_requests")
}

// --------------------------------------------------------
// 9. Agent Audit Logs
// --------------------------------------------------------

model AgentAuditLog {
  id                 BigInt   @id @default(autoincrement())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentName          String
  action             String
  inputStateSummary  Json?
  outputStateSummary Json?
  modelVersion       String?
  tokensConsumed     Int      @default(0)
  createdAt          DateTime @default(now())

  @@map("agent_audit_logs")
}

// --------------------------------------------------------
// 10. Connected Integrations (OAuth credentials encrypted)
// --------------------------------------------------------

model ConnectedIntegration {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     IntegrationProvider
  accessToken  String
  refreshToken String?
  scopes       String[]            @default([])
  isActive     Boolean             @default(true)
  lastSyncedAt DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([userId, provider])
  @@map("connected_integrations")
}

// --------------------------------------------------------
// 11. Personalized Learning Roadmap
// --------------------------------------------------------

model LearningPlan {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  title     String
  status    String   @default("IN_PROGRESS")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks LearningTask[]

  @@map("learning_plans")
}

model LearningTask {
  id             String       @id @default(uuid())
  planId         String
  plan           LearningPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  skillName      String
  title          String
  description    String?
  resourceUrl    String?
  estimatedHours Decimal?     @db.Decimal(4, 1)
  isCompleted    Boolean      @default(false)
  completedAt    DateTime?

  @@map("learning_tasks")
}

// --------------------------------------------------------
// 12. Portfolio Website & Hosting
// --------------------------------------------------------

model PortfolioSite {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subdomain    String    @unique
  theme        String    @default("modern")
  isPublished  Boolean   @default(false)
  publishedAt  DateTime?
  customConfig Json?
  updatedAt    DateTime  @updatedAt

  @@map("portfolio_sites")
}
